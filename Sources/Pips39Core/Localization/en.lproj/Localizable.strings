/* Umgebungshinweis. Feststellung, nie Entwarnung — siehe LocalizationRuleTests. */
"env.connected" = "This device is connected to a network.";

/* Verfahren: Kurzbeschreibung */
"method.sha256.summary" = "Your dice sequence is hashed with SHA-256. Verify with shasum and any BIP39 tool.";
"method.coleman.summary" = "Bit-for-bit identical to iancoleman.io/bip39. Verify by entering the same rolls there.";

/* Verfahren: Wurfzahl. %d ist die Zahl. */
"method.sha256.rollCount" = "Exactly %d rolls.";
"method.coleman.rollCount" = "Around %d rolls, but the exact number varies.";

/* Wortzahl. %d ist die Zahl. */
"seedLength.title" = "%d words";

/* Nachrechnen: Warnung */
"verify.warning" = "Use a throwaway sequence to try this out. Never type your real rolls into a browser.";

/* Nachrechnen: SHA-256. Der shasum-Befehl bleibt unübersetzt. */
"verify.sha256.step.hash" = "Run: printf '%s' \"<your rolls>\" | shasum -a 256";
"verify.sha256.step.truncate" = "Take only the first 32 hex characters — 12 words use 128 of the 256 bits.";
"verify.sha256.step.paste" = "Open iancoleman.io/bip39 and paste the hex into the Entropy field.";
"verify.sha256.step.compare" = "Set Entropy type to Hex, then compare the words.";

/* Nachrechnen: Coleman. „Dice" und „Use Raw Entropy" sind Beschriftungen auf
   seiner englischen Seite und bleiben in jeder Sprache englisch. */
"verify.coleman.step.open" = "Open iancoleman.io/bip39.";
"verify.coleman.step.dice" = "Select the Dice entropy type first — otherwise a sequence of only 1s is read as binary.";
"verify.coleman.step.raw" = "Leave Mnemonic Length on Use Raw Entropy — a fixed word count hashes instead and truncates the other way.";
"verify.coleman.step.enter" = "Enter exactly the rolls shown here, no more, and compare the words.";
